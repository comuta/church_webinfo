---
const kacheln = [
  { href: '#livestream', text: 'Gottesdienste', icon: 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z' },
  { href: '#livestream', text: 'Livestream', icon: 'M3 14v-2a9 9 0 0 1 18 0v2M3 14a2 2 0 0 1 2-2h1v7H5a2 2 0 0 1-2-2Zm18 0a2 2 0 0 0-2-2h-1v7h1a2 2 0 0 0 2-2Z' },
  { href: '#anfahrt', text: 'Anfahrt', icon: 'M12 22s7-6.5 7-12a7 7 0 0 0-14 0c0 5.5 7 12 7 12Zm0-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z' },
  { href: '#kontakt', text: 'Kontakt', icon: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm-1 1 9 7 9-7' },
];
---

<nav class="schnellzugriff" aria-label="Schnellzugriff">
  <ul class="container schnellzugriff__liste">
    {kacheln.map((k) => (
      <li>
        <a class="schnellzugriff__kachel" href={k.href}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d={k.icon} />
          </svg>
          <span>{k.text}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .schnellzugriff {
    background: var(--farbe-akzent-flaeche);
    color: var(--farbe-akzent-text);
  }

  /* Basis: 2 × 2 Kacheln, ab md alle in einer Reihe */
  .schnellzugriff__liste {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--abstand-xs);
    padding-block: var(--abstand-md);
    list-style: none;
  }

  @media (min-width: 48rem) {
    .schnellzugriff__liste {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .schnellzugriff__kachel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: var(--abstand-sm);
    border-radius: var(--radius);
    color: inherit;
    font-family: var(--schrift-ueberschrift);
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .schnellzugriff__kachel:hover {
    background: rgb(255 255 255 / 0.15);
  }

  .schnellzugriff__kachel svg {
    width: 2.25rem;
    height: 2.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
